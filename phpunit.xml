<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.2/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!--
            Unit drives the delivery policy against an in-memory store.
            Integration runs the real SQL against a migrated SQLite database,
            which is the only way to catch a column that does not exist or a
            conditional UPDATE whose row count the code never checks.
        -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">API</directory>
            <directory suffix=".php">Application</directory>
            <directory suffix=".php">Domain</directory>
            <directory suffix=".php">Infrastructure</directory>
        </include>
    </source>
</phpunit>
